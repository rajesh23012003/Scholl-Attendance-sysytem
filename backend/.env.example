# ==============================================================
# SCHOOL ATTENDANCE SYSTEM - AWS & DATABASE CONFIGURATION
# ==============================================================

# Server Port
PORT=5000

# --------------------------------------------------------------
# 1. DATABASE CONFIGURATION (AWS RDS MySQL / SQLite)
# --------------------------------------------------------------
# Set DB_TYPE to 'mysql' for AWS RDS MySQL, or 'sqlite' for local fallback
DB_TYPE=sqlite

# AWS RDS MySQL Credentials (fill these after launching RDS)
DB_HOST=attendance-rds-mysql.c123456789.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=school_attendance_db
DB_USER=admin
DB_PASSWORD=YourSecurePassword123!

# --------------------------------------------------------------
# 2. AWS VPC & NETWORKING (Metadata for Cloud Architecture)
# --------------------------------------------------------------
AWS_VPC_ID=vpc-0a1b2c3d4e5f6g7h8
AWS_VPC_CIDR=10.0.0.0/16
AWS_PUBLIC_SUBNET_1=subnet-pub-1a (10.0.1.0/24 - us-east-1a)
AWS_PUBLIC_SUBNET_2=subnet-pub-1b (10.0.2.0/24 - us-east-1b)
AWS_PRIVATE_SUBNET_1=subnet-priv-1a (10.0.10.0/24 - us-east-1a)
AWS_PRIVATE_SUBNET_2=subnet-priv-1b (10.0.20.0/24 - us-east-1b)

# --------------------------------------------------------------
# 3. AWS CREDENTIALS & REGION
# --------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --------------------------------------------------------------
# 4. AWS S3 (Storage for Attendance CSV, Reports, Backups)
# --------------------------------------------------------------
AWS_S3_BUCKET=school-attendance-reports-bucket

# --------------------------------------------------------------
# 5. AWS CLOUDWATCH (Logs & Monitoring)
# --------------------------------------------------------------
AWS_CLOUDWATCH_GROUP=/aws/ec2/school-attendance-system
AWS_CLOUDWATCH_STREAM=production-app
